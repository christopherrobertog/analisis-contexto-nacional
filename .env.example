# Copiar este archivo como .env.local (dashboard) o .env (scripts) y completar según el entorno.
# No incluir valores reales de credenciales en este archivo ni en el repositorio.

# URL pública de la API del dashboard (si se separa backend/frontend)
NEXT_PUBLIC_API_URL=

# URL base de datos procesados que consume el dashboard (JSON estático o API)
NEXT_PUBLIC_DATA_SOURCE_URL=

# Base URL de la API del Banco Mundial (por defecto no requiere clave)
WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2

# Clave opcional si se integra una fuente que la requiera (ej. FRED API de EE.UU.)
FRED_API_KEY=
